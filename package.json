{
  "name": "zumen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI が描き、人が直し、また AI が理解できる構成図エディタ（Phase 0 / 計測段階）",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "app": "tauri dev",
    "app:build": "tauri build",
    "build:app": "vite build",
    "d2:conflict": "node experiments/d2/git-conflict.ts",
    "dev": "vite",
    "drawio": "node src/cli.ts drawio",
    "embed": "node src/cli.ts embed",
    "gui:check": "node scripts/gui-check.mjs",
    "measure": "node src/cli.ts measure",
    "merge": "node src/cli.ts merge",
    "merge-driver": "node src/cli.ts merge-driver",
    "mermaid": "node src/cli.ts mermaid",
    "s1": "node experiments/s1/run.ts",
    "s3": "node experiments/s3/run.ts",
    "s3:quality": "node experiments/s3-quality/run.ts",
    "svg": "node src/cli.ts svg",
    "tauri": "tauri",
    "test": "node --test \"test/**/*.test.ts\" \"experiments/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "node src/cli.ts validate"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "elkjs": "^0.12.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.15.0",
    "svelte": "^5.57.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "minimumReleaseAge": 1440,
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
